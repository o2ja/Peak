# PostgreSQL connection (local cluster from `npm run db:init`, or docker-compose on port 5433)
DATABASE_URL="postgresql://peak:CHANGE_ME@localhost:5433/peak"
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="CHANGE_ME"
PORT=4000
# Comma-separated origins allowed to call the API with cookies (the Next.js app)
WEB_ORIGIN="http://localhost:3000"
# Where uploaded menu images are stored in development
UPLOAD_DIR="./uploads"
# Public base URL of this API, used to build absolute image URLs
PUBLIC_API_URL="http://localhost:4000"
